{
  "name": "@amcharts/amcharts5-mcp",
  "version": "1.7.1",
  "mcpName": "io.github.amcharts/amcharts5",
  "description": "On-demand access to amCharts 5 docs, code examples, and API reference",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "amcharts5-mcp": "src/index.js"
  },
  "files": [
    "src/",
    "content/",
    "extended/",
    "!extended/reference-generated/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node scripts/check-examples.js && node test.js",
    "check:examples": "node scripts/check-examples.js",
    "build:examples": "node scripts/build-examples.js",
    "clean:examples": "node scripts/clean-examples2.js && node scripts/clean-all.js extended/examples && node scripts/check-examples.js",
    "build:worker": "node scripts/build-worker-content.js",
    "build:reference": "node scripts/generate-reference.cjs",
    "dev:worker": "npm run build:worker && wrangler dev",
    "deploy": "npm run build:worker && wrangler deploy",
    "prepublishOnly": "node -e \"const fs=require('fs');if(!fs.existsSync('content'))fs.mkdirSync('content');fs.cpSync('amcharts5-skill/amcharts5-skill/SKILL.md','content/SKILL.md');for(const f of fs.readdirSync('amcharts5-skill/amcharts5-skill/references').filter(x=>x.endsWith('.md')))fs.cpSync('amcharts5-skill/amcharts5-skill/references/'+f,'content/'+f)\"",
    "postpublish": "node -e \"require('fs').rmSync('content',{recursive:true,force:true})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amcharts/amcharts5-mcp.git"
  },
  "homepage": "https://github.com/amcharts/amcharts5-mcp#readme",
  "bugs": {
    "url": "https://github.com/amcharts/amcharts5-mcp/issues"
  },
  "keywords": [
    "amcharts",
    "mcp",
    "model-context-protocol",
    "ai",
    "charts",
    "data-visualization",
    "claude",
    "cursor",
    "windsurf",
    "copilot",
    "vscode"
  ],
  "author": "amCharts",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25 || ^4.0"
  },
  "devDependencies": {
    "@amcharts/amcharts5": "5.21.0",
    "agents": "^0.16.2",
    "jsdom": "^29.0.0",
    "turndown": "^7.2.2",
    "typescript": "5.9.3",
    "wrangler": "^4.102.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
  }
}
