{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amcharts5-mcp",
  "main": "cloudflare/index.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // PNG imports are bundled as bytes (the icon at /icon.png)
  "rules": [
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  // Serve on the custom domain. Requires amcharts.com to be a zone in this
  // Cloudflare account; on deploy, Cloudflare creates the DNS record + TLS
  // cert automatically. Endpoints: https://mcp.amcharts.com/mcp (+ /sse).
  //
  // SELF-HOSTING: this is amCharts's production domain. To run your own copy,
  // change "pattern" to a subdomain in YOUR Cloudflare account, or delete this
  // whole "routes" block to serve at <name>.<account>.workers.dev instead.
  // See "Self-hosting on your own Cloudflare account" in cloudflare/DEPLOYMENT.md.
  "routes": [
    {
      "pattern": "mcp.amcharts.com",
      "custom_domain": true
    }
  ],
  // The legacy /sse endpoint keeps its sessions in a SQLite-backed Durable
  // Object. /mcp has no sessions and doesn't use it.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AmCharts5MCP"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AmCharts5MCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  // Anonymous counts of connections and tool calls (cloudflare/usage.js): fixed
  // labels only. Read them with `npm run usage`.
  "analytics_engine_datasets": [
    {
      "binding": "USAGE",
      "dataset": "amcharts5_mcp_usage"
    }
  ],
  // Error and warning messages are kept; per-request invocation logs and traces
  // are off. See "Privacy" in README.md.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  // OpenAI's plugin directory checks the domain by fetching this token from
  // /.well-known/openai-apps-challenge. It is public by design.
  "vars": {
    "OPENAI_APPS_CHALLENGE": "s2nJ4ivIteCJDkWzZ_mB6cTUwe5yserrvm7IP8htaXE"
  }
}
